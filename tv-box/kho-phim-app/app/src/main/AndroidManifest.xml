<?xml version="1.0" encoding="utf-8"?>
<!-- App "Kho phim" cho TV box: một màn WebView toàn màn hình mở máy chủ phim chạy ngay trên box
     (Termux, cổng 3000). http thường vì chỉ đi trong máy: 127.0.0.1. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nhờ Termux chạy lại máy chủ phim khi nó chết (MainActivity.goiTermux). Quyền nguy hiểm: cấp bằng adb
         (tv-box/thiet-lap-box.sh). -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Android 11+: phải khai báo thì mới gọi được dịch vụ của app khác -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Kho phim"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
